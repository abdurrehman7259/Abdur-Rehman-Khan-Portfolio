rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Replace with the UID of your admin user (Firebase console > Authentication > Users)
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'REPLACE_WITH_ADMIN_UID';
    }

    match /posts/{slug} {
      // Visitors can read published posts only; admin can read drafts too.
      allow read: if resource.data.published == true || isAdmin();
      // Only the admin can create / edit / delete.
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
